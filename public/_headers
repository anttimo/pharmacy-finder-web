# Response headers for the static assets (ADR 0004). Workers static assets read this file;
# it doesn't apply to `npm run dev` or to the Worker's own /api/* responses.
# connect-src 'self': the pharmacy list is a static asset and geocoding goes through our Worker.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
