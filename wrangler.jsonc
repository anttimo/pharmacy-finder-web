// Cloudflare Worker config (ADR 0004). After changing it, run `npm run cf-typegen`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pharmacy-finder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    // Unknown paths get index.html, so the SPA loads on any URL.
    "not_found_handling": "single-page-application",
    // Without this, the SPA fallback would answer /api/* with index.html. Every other
    // request is served as a static asset without running Worker code.
    "run_worker_first": ["/api/*"],
  },
  // Set with `npx wrangler secret put` and kept in .dev.vars locally (ADR 0003, 0004). Listing
  // it here types it in `npm run cf-typegen` even without a .dev.vars file.
  "secrets": {
    "required": ["DIGITRANSIT_API_KEY"],
  },
}
